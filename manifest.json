{
  "manifest_version": 3,
  "name": "Juya 资讯跳段",
  "version": "0.4.0",
  "description": "优先使用橘鸦Juya评论时间轴；缺失时读取视频章节条 OCR 并谨慎跳段。",
  "permissions": ["scripting", "storage", "tabs", "webNavigation"],
  "host_permissions": ["https://www.bilibili.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.bilibili.com/*"],
    "js": ["autostart.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Juya 资讯跳段",
    "default_popup": "popup.html"
  }
}
